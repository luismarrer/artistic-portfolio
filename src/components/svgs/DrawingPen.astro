---
interface Props {
    id?: string
    class?: string
    /** Size in the host SVG's user units; the trail sets its own per viewport width. */
    scale?: number
}

const { id, class: className, scale = 1 } = Astro.props
---

{/*
  A pointed dip pen. Its nib tip sits on the local origin, so a motion path carries the tip along
  the ink by x/y alone. It keeps a right hand's lean on every heading: a pen turned to follow the
  stroke reads as an arrow.
*/}
<g id={id} class={className} aria-hidden="true">
    <g data-pen-scale transform={`scale(${scale})`}>
        <g transform="rotate(32)">
            <path
                d="M-2.5 -17.6 C-2.95 -24 -2.7 -32 -2.05 -40 C-1.85 -43.6 -1.3 -45.7 0 -45.9 C1.3 -45.7 1.85 -43.6 2.05 -40 C2.7 -32 2.95 -24 2.5 -17.6 Z"
                fill="var(--color-drawing-ink)"></path>
            <path
                d="M-1.45 -20.5 C-1.75 -26.5 -1.6 -33 -1.15 -39"
                stroke="#FFFDD0"
                stroke-width="0.6"
                stroke-linecap="round"
                opacity="0.32"></path>
            <path d="M-2.75 -11.4 H2.75 L2.5 -17.8 H-2.5 Z" fill="#A07E4A"></path>
            <path d="M-2.7 -13 H2.7 M-2.55 -16.3 H2.55" stroke="#6E5530" stroke-width="0.45"></path>
            <path
                d="M0 0 C0.7 -2.4 2.6 -5.6 2.75 -8.6 L2.6 -11.6 H-2.6 L-2.75 -8.6 C-2.6 -5.6 -0.7 -2.4 0 0 Z"
                fill="#3A3236"></path>
            <path
                d="M0 0 C0.7 -2.4 2.6 -5.6 2.75 -8.6 L2.6 -11.6 H0.9 L0.35 -7.6 Z"
                fill="#8C8287"
                opacity="0.55"></path>
            <path
                d="M0 0 C0.35 -1.2 1 -2.4 1.5 -3.4 H-1.5 C-1 -2.4 -0.35 -1.2 0 0 Z"
                fill="var(--color-drawing-ink)"></path>
            <path d="M0 -0.8 V-6.6" stroke="var(--color-paper)" stroke-width="0.35"></path>
            <circle cx="0" cy="-7.3" r="0.8" fill="var(--color-paper)"></circle>
        </g>
    </g>
</g>
