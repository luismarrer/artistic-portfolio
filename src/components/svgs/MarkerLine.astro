<script>
    import { gsap } from "gsap"
    import { ScrollToPlugin } from "gsap/ScrollToPlugin"

    gsap.registerPlugin(ScrollToPlugin)

    let cleanup = () => {}

    function initializeScroll() {
        cleanup()
        const button = document.querySelector<HTMLAnchorElement>("#start")
        const target = document.getElementById("projects")
        if (!button || !target) return

        const events = new AbortController()
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

        button.addEventListener("click", (event) => {
            // Keep the native anchor for reduced motion and modified clicks.
            if (reducedMotion.matches || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
            event.preventDefault()

            gsap.to(window, {
                duration: 0.8,
                scrollTo: { y: target, offsetY: 24, autoKill: true },
                ease: "power2.inOut",
                overwrite: true,
            })
        }, { signal: events.signal })

        cleanup = () => {
            events.abort()
            gsap.killTweensOf(window)
        }
    }

    document.addEventListener("astro:page-load", initializeScroll)
    document.addEventListener("astro:before-swap", () => cleanup())
</script>
