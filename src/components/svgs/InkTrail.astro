---
import DrawingPen from "@/components/svgs/DrawingPen.astro"
---

<div id="ink-trail" class="ink-trail" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none">
        <path
            id="ink-path"
            stroke="var(--color-drawing-ink)"
            stroke-linecap="round"
            stroke-linejoin="round"
        ></path>
        <DrawingPen id="ink-pen" />
    </svg>
</div>
