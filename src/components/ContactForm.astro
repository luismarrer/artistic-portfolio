---
import { site } from "@/data/site"

interface Props {
  title?: string
  subtitle?: string
}

const {
  title = site.contact.title,
  subtitle = site.contact.subtitle,
} = Astro.props
const isDemo = site.contact.mode === "demo"
---

<section id="contact" class="page-intro pb-12 sm:pb-20 min-h-svh">
  <div class="mx-auto px-[var(--page-gutter)]">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-8 sm:mb-12">
        <h1
          class="text-3xl sm:text-4xl md:text-5xl mb-4"
          data-reveal="title"
        >
          {title}
        </h1>
        <p class="copy mx-auto text-(--color-muted)" data-reveal="copy">
          {subtitle}
        </p>
      </div>

      {isDemo && <p id="contact-demo" class="copy mx-auto mb-6 text-center">{site.contact.demoMessage}</p>}
      <form
        id="contact-form"
        class="space-y-6"
        action={isDemo ? undefined : site.contact.endpoint}
        data-contact-mode={site.contact.mode}
        aria-describedby={isDemo ? "contact-demo" : undefined}
        method="POST"
        data-astro-reload
        data-reveal="copy"
      >
        <fieldset disabled={isDemo} class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="name"
                class="label block mb-2"
              >
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                required
                class="field"
                placeholder="Your name"
              />
            </div>

            <div>
              <label
                for="email"
                class="label block mb-2"
              >
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
                class="field"
                placeholder="your@email.com"
              />
            </div>
          </div>

          <div>
            <label
              for="subject"
              class="label block mb-2"
            >
              Subject
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              class="field"
              placeholder="How can I help you?"
            />
          </div>

          <div>
            <label
              for="message"
              class="label block mb-2"
            >
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="field resize-none"
              placeholder="Tell me about your project..."></textarea>
          </div>

          <div class="text-center">
            <button
              type="submit"
              class="inline-block w-full sm:w-auto bg-(--color-accent) text-(--color-on-accent) px-8 py-4 rounded-lg font-semibold hover:bg-(--color-accent-hover) duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-transform disabled:cursor-not-allowed disabled:opacity-60"
            >
              Send Message
            </button>
          </div>
        </fieldset>
      </form>
      <p
        id="form-status"
        class="mt-6 text-center data-[state=error]:text-red-800 data-[state=success]:text-green-800"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></p>
    </div>
  </div>
</section>
<script>
  import { bootContactForm } from "@/scripts/contact-form"
  bootContactForm()
</script>
