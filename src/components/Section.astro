---
const { title, description } = Astro.props
---

<section class="bg-[#FEEACA] px-[var(--page-gutter)] py-12 sm:py-16 lg:py-24 mx-auto" id={Astro.props.id}>
    <div class="text-center mb-8">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">{title}</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">{description}</p>
    </div>
    <slot />
</section>
