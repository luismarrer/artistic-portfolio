---
const { title, description } = Astro.props
---

<section
  class="px-[var(--page-gutter)] py-12 sm:py-16 lg:py-24 mx-auto"
  id={Astro.props.id}
>
  <div class="text-center mb-8">
    <h2 class="text-3xl sm:text-4xl mb-4" data-reveal="title">
      {title}
    </h2>
    <p
      class="copy mx-auto text-(--color-muted)"
      data-reveal="copy"
    >
      {description}
    </p>
  </div>
  <slot />
</section>
