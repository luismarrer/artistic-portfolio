---
import { site } from "@/data/site"
---

<header
    class="absolute inset-x-0 top-0 z-50 mx-auto flex max-w-[1440px] flex-col items-center justify-between gap-2 px-[var(--page-gutter)] py-4 sm:flex-row sm:gap-6 sm:py-6"
>
    <a href="/" class="flex min-h-11 shrink-0 items-center gap-2" aria-label={`${site.name} home`}>
        <img src={site.logo.src} alt="" width="45" height="45" />
        <h2 class="text-2xl font-bold text-gray-800">{site.name}</h2>
    </a>
    <nav aria-label="Main navigation">
        <ul class="flex flex-wrap justify-center gap-x-2 sm:gap-x-4 md:gap-x-6">
            {site.navigation.map((link) => (
                <li>
                    <a href={link.href} class="flex min-h-11 items-center px-2 text-gray-800 hover:text-[#B22222]">
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</header>
