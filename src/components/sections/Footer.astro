---
import Signature from "@/components/svgs/Signature.astro"
import { site } from "@/data/site"
import type { SocialLink } from "@/data/types"

interface Props {
  siteName?: string
  socialLinks?: SocialLink[]
}

const { siteName = site.name, socialLinks = site.socials } = Astro.props
const currentYear = new Date().getFullYear()
const paragraph = site.footer.description
---

<footer class="bg-white text-black py-12">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-[var(--page-gutter)] md:grid-cols-2 mb-8"
  >
    <section>
      <h3 class="text-2xl font-bold mb-4">{siteName}</h3>
      <p class="text-gray-600">{paragraph}</p>
    </section>
    <section>
      <h4 class="text-lg font-semibold mb-4">{site.footer.linksTitle}</h4>
      <ul class="flex space-x-4">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-11 min-w-11 items-center justify-center text-gray-600 hover:text-black transition-colors"
                aria-label={link.name}
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d={link.icon} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
  <section
    class="border-t mx-auto max-w-7xl border-gray-800 px-[var(--page-gutter)] pt-8 text-center text-gray-600"
  >
    <Signature variant="footer" class="mx-auto mb-4 w-44 md:w-56" />
    <p>&copy; {currentYear} {siteName}. {site.footer.rights}</p>
  </section>
</footer>
