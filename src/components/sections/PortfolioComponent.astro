---
import { projects } from "@/data/projects"
import { site } from "@/data/site"
import type { Project } from "@/data/types"

interface Props {
  items?: Project[]
  variant?: "selection" | "catalogue"
}

const { items = projects, variant = "catalogue" } = Astro.props
const isSelection = variant === "selection"
// The section is a programmatic focus target (tabindex="-1", never in the Tab order): the start
// button hands focus here as soon as it is activated, so the next Tab begins inside the work.
---

<section
  id="projects"
  tabindex="-1"
  class:list={["portfolio-section", { "portfolio-selection": isSelection }]}
  aria-label={isSelection ? site.portfolio.selectedTitle : site.portfolio.catalogueTitle}
>
  {isSelection && (
    <header class="selection-heading">
      <h2>{site.portfolio.selectedTitle}</h2>
      <p class="copy">{site.portfolio.selectedDescription}</p>
    </header>
  )}
  <div class:list={["grid projects-grid", { "selection-grid": isSelection }]} data-trail-content>
    {items.map((project, index) => {
      const cover = project.gallery[0]
      return (
        <article class="project-entry min-w-0" data-project-entry={project.id}>
          <a href={`/projects/${project.id}`} class="project-card">
            <div class="project-artwork print">
              <img
                src={cover.src}
                alt={cover.alt}
                width={cover.width}
                height={cover.height}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                style={cover.focalPoint ? `--focal: ${cover.focalPoint}` : undefined}
              />
            </div>
            <div class="project-summary min-w-0">
              <p class="label">{project.category}</p>
              <h3>{project.title}</h3>
              <p class:list={["project-context", isSelection ? "copy" : "copy-small"]}>{project.description}</p>
              <span class="case-link">{site.portfolio.caseLinkLabel} <span aria-hidden="true">→</span></span>
            </div>
          </a>
          <p class="cover-credit caption">
            <a href={cover.authorLink} target="_blank" rel="noopener noreferrer">{cover.authorName}</a>
            <span aria-hidden="true"> · </span>
            <a href={cover.sourceLink} target="_blank" rel="noopener noreferrer">{cover.sourceName}</a>
          </p>
        </article>
      )
    })}
  </div>
  {isSelection && (
    <p class="catalogue-link">
      <a href="/portfolio">{site.portfolio.catalogueLinkLabel} <span aria-hidden="true">→</span></a>
    </p>
  )}
</section>

<style>
  /* Transparent on purpose: every route is one sheet of paper, and the hero's grid tail runs behind this section. */
  .portfolio-section {
    padding: 1.5rem var(--page-gutter) 3rem;
  }
  /* Paints above the hero's grid tail (see Hero.astro), below the ink trail (z-index 25). */
  .portfolio-selection {
    position: relative;
    z-index: 1;
  }
  .selection-heading, .projects-grid, .catalogue-link {
    max-width: 72rem;
    margin-inline: auto;
  }
  .selection-heading {
    margin-bottom: 1.5rem;
  }
  .selection-heading h2 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.2;
  }
  .selection-heading p {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }
  .projects-grid {
    gap: 2.5rem;
    align-items: start;
  }
  .project-card {
    display: grid;
    gap: 1.25rem;
    border-radius: var(--radius-print);
    color: var(--color-ink);
  }
  /*
   * The mount, shadow and radius come from .print; this only sets the stable 4:3 cover crop.
   * --focal is the cover's validated focalPoint ("<x>% <y>%"), set inline from project data; centered by default.
   */
  .project-artwork {
    width: 100%;
  }
  .project-artwork img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: var(--focal, center);
  }
  .project-summary h3 {
    margin-top: 0.35rem;
    font-size: clamp(1.4rem, 2.5vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
  }
  .project-context {
    margin-top: 0.75rem;
    color: var(--color-muted);
  }
  .case-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  .cover-credit {
    margin-top: 0.75rem;
  }
  .cover-credit a {
    display: inline-block;
    padding-block: 0.375rem;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .catalogue-link {
    margin-top: 1.5rem;
  }
  .catalogue-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  @media (min-width: 48rem) {
    .projects-grid:not(.selection-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
    .selection-grid .project-card {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      align-items: center;
      gap: 2.5rem;
    }
    .selection-grid .project-entry {
      max-width: 72rem;
    }
    .portfolio-section {
      padding-bottom: 4rem;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .project-card:hover .case-link {
      text-decoration-thickness: 0.15em;
    }
  }
</style>
