---
import KeepScrolling from "@/assets/keep-scrolling.svg"
import Signature from "@/components/svgs/Signature.astro"

const heroTitle = "Turn Your Ideas Into Art"
---

<section
    data-hero
    class="relative
            min-h-svh
            flex
            flex-col
            items-center
            justify-center
            text-center
            px-[var(--page-gutter)]
            pt-[var(--header-space)]
            pb-28
            overflow-hidden
            grid-background"
>
    <div class="z-10 flex w-full flex-col items-center max-w-4xl mx-auto">
        <h1
            class="js-hero-title hero-heading w-full text-[clamp(2.75rem,7.5vw,4.5rem)] font-bold text-[#F9FAFB] leading-tight drop-shadow-sm"
        >
            {
                heroTitle.split(" ").map((word) => (
                    <span class="inline-block mr-[0.28em] last:mr-0">{word}</span>
                ))
            }
        </h1>
        <Signature variant="hero" class="mt-5 w-72 sm:w-96 md:w-[28rem]" />
        <a
            id="start"
            href="#projects"
            data-magnetic
            class="mt-8
                bg-[#B22222]
                text-[#FFFDD0]
                font-semibold
                py-3
                px-8
                rounded-lg
                shadow-lg
                hover:bg-[#A52A2A]
                text-lg
                will-change-transform"
        >
            See my recent works
        </a>
    </div>
    <div class="absolute bottom-6 right-0 left-0 mx-auto">
        <KeepScrolling class="js-scroll-hint mx-auto text-[#F9FAFB] drop-shadow-2xl" />
    </div>

    <style>
        .grid-background {
            box-shadow: 0 40px 60px -20px rgba(243, 172, 158, 0.5) inset;
            background-image: linear-gradient(
                    to right,
                    rgba(178, 34, 34, 0.2) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    to bottom,
                    rgba(178, 34, 34, 0.2) 1px,
                    transparent 1px
                ),
                linear-gradient(to bottom, #f3ac9e 0%, #ffeaca 100%);
            background-size: 35px 35px, 35px 35px, 100% 100%;
        }

        .hero-heading {
            font-kerning: none;
            text-rendering: optimizeSpeed;
        }
    </style>
</section>
