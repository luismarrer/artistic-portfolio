---
import KeepScrolling from "@/assets/keep-scrolling.svg"
import HeroGesture from "@/components/svgs/HeroGesture.astro"
import { site } from "@/data/site"

const heroTitle = site.hero.title
---

{/* Owner-pinned rule (AGENTS.md): on entry the grid fills the visitor's whole screen. Keep min-h-svh; never size the hero to its content. */}
<section
    data-hero
    class="relative
            min-h-svh
            hero
            flex
            flex-col
            items-center
            justify-center
            text-center
            px-[var(--page-gutter)]
            pt-[var(--header-space)]
            overflow-x-clip
            grid-background"
>
    <div class="z-10 flex w-full flex-col items-center max-w-4xl mx-auto">
        <h1
            class="js-hero-title hero-heading w-full text-[clamp(2.75rem,7.5vw,4.5rem)] leading-tight"
        >
            {
                heroTitle.split(" ").map((word) => (
                    <span class="inline-block mr-[0.28em] last:mr-0">{word}</span>
                ))
            }
        </h1>
        <HeroGesture class="mt-3 w-52 sm:w-56" />
        <a
            id="start"
            href={site.hero.buttonHref}
            data-magnetic
            class="hero-cta mt-4
                font-semibold
                py-3
                px-8
                rounded-lg
                shadow-lg
                text-lg
                will-change-transform"
        >
            {site.hero.buttonLabel}
        </a>
    </div>
    <div class="absolute bottom-6 right-0 left-0 mx-auto">
        <KeepScrolling class="js-scroll-hint mx-auto text-(--color-ink)" />
    </div>

    <style>
        .hero {
            padding-bottom: 3rem;
        }
        .hero-cta {
            background: var(--color-accent);
            color: var(--color-on-accent);
        }
        .hero-cta:hover {
            background: var(--color-accent-hover);
        }
        /*
         * A peach wash that ends exactly in paper at the hero's bottom edge, under a ruled grid.
         * The ruled rows are anchored to that bottom edge, so the grid tail below the hero starts
         * on a line and the rows continue at the same pitch. Both layers draw the same lines.
         */
        .grid-background {
            --grid-lines: linear-gradient(to right, var(--color-grid-line) 1px, transparent 1px),
                linear-gradient(to bottom, var(--color-grid-line) 1px, transparent 1px);
            background-image: var(--grid-lines),
                linear-gradient(to bottom, var(--color-peach) 0%, var(--color-paper) 100%);
            background-size: var(--grid-size) var(--grid-size), var(--grid-size) var(--grid-size), 100% 100%;
            background-position: 0 100%, 0 100%, 0 0;
        }
        /*
         * The grid keeps going behind the start of the first work and fades out. It is decorative:
         * out of flow (the hero's layout box, which the ink trail measures, does not change),
         * pinned to both hero edges (no horizontal overflow) and inert. The selected work
         * (#projects, z-index 1) paints above it; the ink trail (z-index 25) stays above everything.
         */
        .grid-background::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            height: clamp(8rem, 20vw, 16rem);
            pointer-events: none;
            background-image: var(--grid-lines);
            background-size: var(--grid-size) var(--grid-size);
            -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgb(0 0 0 / 0.55) 45%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 0%, rgb(0 0 0 / 0.55) 45%, transparent 100%);
        }

        .hero-heading {
            color: var(--color-ink);
            font-kerning: none;
            text-rendering: optimizeSpeed;
        }
    </style>
</section>
