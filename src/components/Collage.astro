---
import type { GalleryImage } from "@/data/types"

interface Props {
  images: GalleryImage[]
  label?: string
  /** View-transition name for the cover print: pass the name its catalogue card uses and the cover morphs between pages. */
  coverTransitionName?: string
}

const { images, label = "Artwork gallery", coverTransitionName } = Astro.props
if (!images?.length) {
  throw new Error("Collage requires an explicit, nonempty credited gallery")
}

// One set of attributes for the named and the plain print, so the two branches below never drift apart.
const artwork = (image: GalleryImage, isCover: boolean) =>
  ({
    src: image.src,
    alt: image.alt,
    width: image.width,
    height: image.height,
    class: "block h-auto w-full",
    loading: isCover ? "eager" : "lazy",
    fetchpriority: isCover ? "high" : undefined,
    decoding: "async",
  }) as const
---

<section
  class="mx-auto max-w-6xl px-[var(--page-gutter)] py-8 sm:py-12"
  aria-label={label}
  data-project-gallery
>
  <div class="grid items-start gap-x-8 gap-y-10 md:grid-cols-2 md:gap-y-14">
    {
      images.map((image, index) => (
        <figure
          class:list={["min-w-0", (index === 0 || image.size === "large") && "md:col-span-2"]}
          data-project-cover={index === 0 ? "" : undefined}
          data-reveal={index === 0 ? undefined : "card"}
        >
          {/* The cover arrives by morphing from its card, so it has no data-reveal entrance of its own; the other prints keep their calm settle. */}
          {/* Gallery artwork keeps its natural ratio inside the print mount: never cropped. */}
          {index === 0 && coverTransitionName ? (
            <div class="print" transition:name={coverTransitionName} transition:animate="initial">
              <img {...artwork(image, true)} />
            </div>
          ) : (
            <div class="print">
              <img {...artwork(image, index === 0)} />
            </div>
          )}
          <figcaption class="mt-4 space-y-1">
            <p class="copy-small">{image.caption}</p>
            <p class="caption">
              By{" "}
              <a
                href={image.authorLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block py-2 underline decoration-(--color-accent)/40 underline-offset-4 hover:text-(--color-accent)"
              >
                {image.authorName}
              </a>
              {" · "}
              <a
                href={image.sourceLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block py-2 underline decoration-(--color-accent)/40 underline-offset-4 hover:text-(--color-accent)"
              >
                {image.sourceName}
              </a>
            </p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
