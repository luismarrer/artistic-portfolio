---
import type { GalleryImage } from "@/data/types"

interface Props {
  images: GalleryImage[]
  label?: string
}

const { images, label = "Artwork gallery" } = Astro.props
if (!images?.length) {
  throw new Error("Collage requires an explicit, nonempty credited gallery")
}
---

<section
  class="mx-auto max-w-6xl px-[var(--page-gutter)] py-8 sm:py-12"
  aria-label={label}
  data-project-gallery
>
  <div class="grid items-start gap-x-8 gap-y-10 md:grid-cols-2 md:gap-y-14">
    {
      images.map((image, index) => (
        <figure
          class:list={["min-w-0", (index === 0 || image.size === "large") && "md:col-span-2"]}
          data-project-cover={index === 0 ? "" : undefined}
          data-reveal="card"
        >
          {/* Gallery artwork keeps its natural ratio inside the print mount: never cropped. */}
          <div class="print">
            <img
              src={image.src}
              alt={image.alt}
              width={image.width}
              height={image.height}
              class="block h-auto w-full"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : undefined}
              decoding="async"
            />
          </div>
          <figcaption class="mt-4 space-y-1">
            <p class="copy-small">{image.caption}</p>
            <p class="caption">
              By{" "}
              <a
                href={image.authorLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block py-2 underline decoration-(--color-accent)/40 underline-offset-4 hover:text-(--color-accent)"
              >
                {image.authorName}
              </a>
              {" · "}
              <a
                href={image.sourceLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block py-2 underline decoration-(--color-accent)/40 underline-offset-4 hover:text-(--color-accent)"
              >
                {image.sourceName}
              </a>
            </p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
