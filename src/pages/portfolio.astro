---
import Layout from "@/layouts/Layout.astro"
import Drawing from "@/components/svgs/Drawing.astro"
import Collage from "@/components/Collage.astro"
import PortfolioComponent from "@/components/sections/PortfolioComponent.astro"
import Footer from "@/components/sections/Footer.astro"
---

<Layout title="Portfolio" description="Explore my creative work and projects">
    <section class="page-intro mx-auto max-w-5xl px-[var(--page-gutter)] pb-12 sm:pb-16">
        <h1 class="text-3xl sm:text-4xl font-bold text-center">Portfolio Page</h1>
        <Drawing />
    </section>
    <PortfolioComponent />
    <section>
        <h2 class="text-2xl sm:text-3xl font-bold text-center mt-12 sm:mt-20 px-[var(--page-gutter)]">See all my work</h2>
        <Collage />
    </section>
    <Footer />
</Layout>
