---
import Layout from "@/layouts/Layout.astro"
import { projects } from "@/data/projects"
import type { Project } from "@/data/types"
import Footer from "@/components/sections/Footer.astro"
import Collage from "@/components/Collage.astro"

interface Props {
    project: Project
    nextProject?: Project
}

export function getStaticPaths() {
    return projects.map((project, index) => ({
        params: { id: String(project.id) },
        props: {
            project,
            nextProject: projects.length > 1 ? projects[(index + 1) % projects.length] : undefined,
        },
    }))
}

const { project, nextProject } = Astro.props
const { title, description, gallery, editorial } = project
const notes = [
    { title: "Context", body: editorial.context },
    { title: "Selection process", body: editorial.process },
    { title: "Presentation outcome", body: editorial.outcome },
]
---

<Layout title={title} description={description} image={gallery[0]}>
    <section class="page-intro mx-auto max-w-6xl px-[var(--page-gutter)] pb-4 sm:pb-6">
        <p class="label mb-3">
            {project.category}
        </p>
        <h1 class="max-w-4xl text-4xl leading-tight sm:text-5xl" data-reveal="title">
            {title}
        </h1>
        <p class="copy mt-5" data-reveal="copy">
            {description}
        </p>
        <p class="copy-small mt-5 text-(--color-muted)">
            {project.disclosure}
        </p>
    </section>

    <Collage images={gallery} label={`${title} — credited artwork gallery`} />

    <section
        class="mx-auto max-w-6xl px-[var(--page-gutter)] py-10 sm:py-14"
        aria-labelledby="case-notes-title"
    >
        <h2 id="case-notes-title" class="mb-8 text-3xl" data-reveal="title">
            About this collection
        </h2>
        <div class="grid gap-8 lg:grid-cols-3 lg:gap-10">
            {notes.map((note, index) => (
                <article class="border-t border-(--color-accent)/25 pt-5" data-reveal="copy">
                    <p class="caption mb-2" aria-hidden="true">0{index + 1}</p>
                    <h3 class="mb-3 text-xl font-semibold">{note.title}</h3>
                    <p class="copy">{note.body}</p>
                </article>
            ))}
        </div>
    </section>

    <nav
        class="mx-auto grid max-w-6xl gap-4 border-t border-(--color-ink)/20 px-[var(--page-gutter)] py-10 sm:grid-cols-2 sm:gap-6"
        aria-label="Project navigation"
    >
        <a class="flex min-h-11 items-center text-(--color-accent) underline underline-offset-4" href="/portfolio">
            ← Back to all collections
        </a>
        {nextProject && (
            <a class="flex min-h-11 items-center text-(--color-accent) underline underline-offset-4" href={`/projects/${nextProject.id}`} rel="next">
                Next collection: {nextProject.title} →
            </a>
        )}
        <a class="flex min-h-11 items-center underline underline-offset-4" href="/">Home</a>
        <a class="flex min-h-11 items-center underline underline-offset-4" href="/contact">Contact</a>
    </nav>
    <Footer />
</Layout>
