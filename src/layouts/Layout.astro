---
import Header from "@/components/sections/Header.astro"
import InkTrail from "@/components/svgs/InkTrail.astro"
import "@/global.css"
import { ClientRouter } from "astro:transitions" // Before this ViewTransitions
import Analytics from "@vercel/analytics/astro"
import { site } from "@/data/site"
import type { LocalImage } from "@/data/types"
import { validateSocialImage } from "@/data/validation"

interface Props {
  title?: string
  description?: string
  image?: LocalImage
  class?: string
}

const {
  title = site.name,
  description = site.description,
  image = site.socialImage,
  class: className,
} = Astro.props
// Directory output includes a slash at build time; publication uses the existing slashless routes.
const canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const canonical = new URL(canonicalPath, site.publicUrl)
const socialImage = validateSocialImage(image)
const socialImageUrl = new URL(socialImage.src, site.publicUrl)
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    <!-- Fonts -->
    <link
      rel="preload"
      href="/fonts/Mansalva/Mansalva-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/Josefin_Sans/JosefinSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/Josefin_Sans/JosefinSans-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/Josefin_Sans/JosefinSans-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body class="font-sans antialiased">
    {/* First stop for a keyboard: it lets a visitor leave the brand and navigation behind. Shown only on focus (global.css). */}
    <a class="skip-link" href="#main">Skip to content</a>
    <InkTrail />
    <Header />
    {/* tabindex="-1" makes <main> a programmatic focus target, so following the skip link moves focus there in every browser. */}
    <main id="main" tabindex="-1" class:list={["relative", className]}>
      <slot />
    </main>
    <Analytics />
    <script>
      import { bootArtisticMotion } from "@/scripts/artistic-motion"
      bootArtisticMotion()
    </script>
  </body>
</html>
